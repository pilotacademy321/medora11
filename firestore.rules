rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isSignedIn() 
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'bcgmoc@gmail.com' 
          || request.auth.token.email.matches('(?i)^bcgmoc@gmail\\.com$')
        );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRole(role) {
      return role in ['doctor', 'radiology_center', 'laboratory', 'pharmacy', 'patient', 'super_admin', 'secretary', 'wholesaler'];
    }

    function isValidStatus(status) {
      return status in ['incomplete', 'pending', 'approved', 'rejected', 'suspended'];
    }

    // Blueprint Validation for User entity
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'accountId', 'medicalId', 'licenseNumber', 'facilityName', 'governorate', 'phone', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() <= 128
        && isValidRole(data.role)
        && isValidStatus(data.status)
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // Global Account Identifiers Registry: /account_ids/{accountId}
    match /account_ids/{accountId} {
      allow get: if isSignedIn() && (
        resource.data.uid == request.auth.uid 
        || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && (incoming().uid == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isSignedIn() 
        && existing().uid == request.auth.uid 
        && incoming().uid == existing().uid 
        && incoming().accountId == existing().accountId
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
    }

    // Deleted Accounts Tombstones: /deleted_accounts/{uid}
    match /deleted_accounts/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && incoming().uid == uid && incoming().deletedBy == 'self');
      allow update: if isAdmin() || (isOwner(uid) && existing().deletedBy == 'self' && incoming().deletedBy == 'self');
      allow delete: if isAdmin() || (isOwner(uid) && existing().deletedBy == 'self');
    }

    // Users Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().uid == userId
        && (
          (isSuperAdminEmail() && incoming().role == 'super_admin' && incoming().status == 'approved')
          ||
          (incoming().role == 'patient' && incoming().status == 'approved')
          ||
          (incoming().role in ['doctor', 'radiology_center', 'laboratory', 'pharmacy', 'secretary', 'wholesaler'] 
           && incoming().status in ['incomplete', 'pending'])
        );

      allow update: if (
        isAdmin() && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt
      ) || (
        isOwner(userId) 
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && (
          (
            incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'licenseNumber', 'facilityName', 'governorate', 'phone', 'accountId', 'medicalId', 'updatedAt'])
          )
          ||
          (
            isSuperAdminEmail()
            && incoming().role == 'super_admin'
            && incoming().status == 'approved'
          )
        )
      );

      allow delete: if isAdmin() || isOwner(userId);
    }

    // Admins Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get, list: if isSuperAdminEmail();
      allow create: if isSuperAdminEmail() && adminId == request.auth.uid;
      allow update, delete: if isSuperAdminEmail();
    }

    // Doctor Profiles: /doctor_profiles/{doctorId}
    match /doctor_profiles/{doctorId} {
      allow get, list: if isSignedIn();
      allow create: if (isOwner(doctorId) || isAdmin()) 
        && incoming().doctorId == doctorId
        && incoming().doctorId == request.auth.uid;
      allow update: if (isOwner(doctorId) || isAdmin())
        && incoming().doctorId == existing().doctorId;
      allow delete: if isAdmin() || isOwner(doctorId);
    }

    function isSecretaryForDoctor(doctorId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/secretary_assignments/$(request.auth.uid))
        && get(/databases/$(database)/documents/secretary_assignments/$(request.auth.uid)).data.doctorId == doctorId
        && get(/databases/$(database)/documents/secretary_assignments/$(request.auth.uid)).data.status == 'active'
      );
    }

    // Appointments Collection: /appointments/{appointmentId}
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin() ||
        isSecretaryForDoctor(resource.data.doctorId)
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin() ||
        isSecretaryForDoctor(resource.data.doctorId)
      );

      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid || 
        incoming().patientId == request.auth.uid || 
        isSecretaryForDoctor(incoming().doctorId) ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        (
          existing().doctorId == request.auth.uid || 
          isSecretaryForDoctor(existing().doctorId)
        ) ||
        (
          existing().patientId == request.auth.uid && 
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rescheduleReason', 'rescheduleProposedDate', 'updatedAt']) && 
          incoming().status in ['cancelled', 'rescheduled', 'pending']
        ) ||
        isAdmin()
      ) && incoming().doctorId == existing().doctorId && incoming().patientId == existing().patientId;

      allow delete: if isAdmin();
    }

    // Medical Records: /medical_records/{recordId}
    match /medical_records/{recordId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid || 
        incoming().patientId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid || 
        existing().patientId == request.auth.uid || 
        isAdmin()
      ) && incoming().patientId == existing().patientId;

      allow delete: if isSignedIn() && (
        existing().patientId == request.auth.uid || 
        isAdmin()
      );
    }

    // Doctor Patient Charts (Confidential Doctor-Patient Clinical Records): /doctor_patient_charts/{chartId}
    match /doctor_patient_charts/{chartId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid || 
        isAdmin()
      ) && incoming().doctorId == existing().doctorId;
      allow delete: if isAdmin();
    }

    // Secretary Delegations: /secretary_delegations/{delegationId}
    match /secretary_delegations/{delegationId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.secretaryEmail == request.auth.token.email || 
        (resource.data.secretaryUid != null && resource.data.secretaryUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.secretaryEmail == request.auth.token.email || 
        (resource.data.secretaryUid != null && resource.data.secretaryUid == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid || 
        (
          existing().secretaryEmail == request.auth.token.email 
          && incoming().doctorId == existing().doctorId
          && incoming().status == existing().status
          && incoming().permissions == existing().permissions
          && incoming().diff(existing()).affectedKeys().hasOnly(['secretaryUid', 'acceptedAt', 'updatedAt', 'secretaryPhone'])
        ) ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (
        existing().doctorId == request.auth.uid || 
        isAdmin()
      );
    }

    // Secretary Assignments: /secretary_assignments/{secretaryUid}
    match /secretary_assignments/{secretaryUid} {
      allow get: if isSignedIn() && (
        secretaryUid == request.auth.uid || 
        resource.data.doctorId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        secretaryUid == request.auth.uid || 
        resource.data.doctorId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid ||
        (
          secretaryUid == request.auth.uid 
          && incoming().delegationId != null
          && exists(/databases/$(database)/documents/secretary_delegations/$(incoming().delegationId))
          && get(/databases/$(database)/documents/secretary_delegations/$(incoming().delegationId)).data.doctorId == incoming().doctorId
          && get(/databases/$(database)/documents/secretary_delegations/$(incoming().delegationId)).data.secretaryEmail == request.auth.token.email
          && get(/databases/$(database)/documents/secretary_delegations/$(incoming().delegationId)).data.status == 'active'
        ) ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid ||
        (secretaryUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['lastActiveAt', 'secretaryPhone', 'updatedAt'])) ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (
        existing().doctorId == request.auth.uid ||
        isAdmin()
      );
    }

    // Clinic Audit Logs: /clinic_audit_logs/{logId}
    match /clinic_audit_logs/{logId} {
      allow get, list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        (resource.data.actorUid != null && resource.data.actorUid == request.auth.uid) ||
        isSecretaryForDoctor(resource.data.doctorId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().actorUid == request.auth.uid ||
        incoming().doctorId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Radiology Profiles: /radiology_profiles/{centerId}
    match /radiology_profiles/{centerId} {
      allow get, list: if isSignedIn();
      allow create: if (isOwner(centerId) || isAdmin()) 
        && incoming().centerId == centerId
        && incoming().centerId == request.auth.uid;
      allow update: if (isOwner(centerId) || isAdmin())
        && incoming().centerId == existing().centerId;
      allow delete: if isAdmin() || isOwner(centerId);
    }

    // Radiology Services: /radiology_services/{serviceId}
    match /radiology_services/{serviceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().centerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().centerId == request.auth.uid || isAdmin()
      ) && incoming().centerId == existing().centerId;
      allow delete: if isSignedIn() && (
        existing().centerId == request.auth.uid || isAdmin()
      );
    }

    // Radiology Bookings: /radiology_bookings/{bookingId}
    match /radiology_bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.centerId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.centerId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().centerId == request.auth.uid || 
        incoming().patientId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().centerId == request.auth.uid || 
        existing().patientId == request.auth.uid || 
        isAdmin()
      ) && incoming().centerId == existing().centerId;

      allow delete: if isAdmin();
    }

    // Radiology Diagnostic Reports: /radiology_reports/{reportId}
    match /radiology_reports/{reportId} {
      allow get: if isSignedIn() && (
        resource.data.centerId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.centerId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().centerId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().centerId == request.auth.uid || 
        isAdmin()
      ) && incoming().centerId == existing().centerId;

      allow delete: if isAdmin();
    }

    // Laboratory Profiles: /lab_profiles/{labId}
    match /lab_profiles/{labId} {
      allow get, list: if isSignedIn();
      allow create: if (isOwner(labId) || isAdmin()) 
        && incoming().labId == labId
        && incoming().labId == request.auth.uid;
      allow update: if (isOwner(labId) || isAdmin())
        && incoming().labId == existing().labId;
      allow delete: if isAdmin() || isOwner(labId);
    }

    // Laboratory Tests: /lab_tests/{testId}
    match /lab_tests/{testId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().labId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().labId == request.auth.uid || isAdmin()
      ) && incoming().labId == existing().labId;
      allow delete: if isSignedIn() && (
        existing().labId == request.auth.uid || isAdmin()
      );
    }

    // Laboratory Bookings: /lab_bookings/{bookingId}
    match /lab_bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.labId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.labId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().labId == request.auth.uid || 
        incoming().patientId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().labId == request.auth.uid || 
        existing().patientId == request.auth.uid || 
        isAdmin()
      ) && incoming().labId == existing().labId;

      allow delete: if isAdmin();
    }

    // Laboratory Diagnostic Results: /lab_results/{resultId}
    match /lab_results/{resultId} {
      allow get: if isSignedIn() && (
        resource.data.labId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.labId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().labId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().labId == request.auth.uid || 
        isAdmin()
      ) && incoming().labId == existing().labId;

      allow delete: if isAdmin();
    }

    // Pharmacy Profiles: /pharmacy_profiles/{pharmacyId}
    match /pharmacy_profiles/{pharmacyId} {
      allow get, list: if isSignedIn();
      allow create: if (isOwner(pharmacyId) || isAdmin()) 
        && incoming().pharmacyId == pharmacyId
        && incoming().pharmacyId == request.auth.uid;
      allow update: if (isOwner(pharmacyId) || isAdmin())
        && incoming().pharmacyId == existing().pharmacyId;
      allow delete: if isAdmin() || isOwner(pharmacyId);
    }

    // Medicine Inventory: /medicines/{medicineId}
    match /medicines/{medicineId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().pharmacyId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().pharmacyId == request.auth.uid || isAdmin()
      ) && incoming().pharmacyId == existing().pharmacyId;
      allow delete: if isSignedIn() && (
        existing().pharmacyId == request.auth.uid || isAdmin()
      );
    }

    // Pharmacy Orders / Inquiries: /pharmacy_orders/{orderId}
    match /pharmacy_orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.pharmacyId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.pharmacyId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().pharmacyId == request.auth.uid || 
        incoming().patientId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().pharmacyId == request.auth.uid || 
        existing().patientId == request.auth.uid || 
        isAdmin()
      ) && incoming().pharmacyId == existing().pharmacyId;

      allow delete: if isAdmin();
    }

    // Electronic Prescriptions: /electronic_prescriptions/{prescriptionId}
    match /electronic_prescriptions/{prescriptionId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        (resource.data.targetPharmacyId != null && resource.data.targetPharmacyId == request.auth.uid) ||
        (resource.data.dispensedPharmacyId != null && resource.data.dispensedPharmacyId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        resource.data.targetPharmacyId == request.auth.uid || 
        resource.data.dispensedPharmacyId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        (existing().doctorId == request.auth.uid && existing().status in ['draft', 'sent']) ||
        (
          (existing().targetPharmacyId == request.auth.uid || existing().dispensedPharmacyId == request.auth.uid || incoming().dispensedPharmacyId == request.auth.uid)
          && incoming().doctorId == existing().doctorId
          && incoming().patientId == existing().patientId
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'dispensedPharmacyId', 'dispensedPharmacyName', 'dispensedAt', 'pharmacistNotes', 'updatedAt'])
          && incoming().status in ['dispensed', 'processing', 'sent']
        ) ||
        isAdmin()
      ) && incoming().doctorId == existing().doctorId && incoming().patientId == existing().patientId;

      allow delete: if isAdmin();
    }

    // Diagnostic Lab Orders: /lab_orders/{orderId}
    match /lab_orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        (resource.data.targetLabId != null && resource.data.targetLabId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        (resource.data.targetLabId != null && resource.data.targetLabId == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid || 
        (existing().targetLabId != null && existing().targetLabId == request.auth.uid) ||
        isAdmin()
      ) && incoming().doctorId == existing().doctorId;

      allow delete: if isAdmin();
    }

    // Diagnostic Radiology Orders: /radiology_orders/{orderId}
    match /radiology_orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        (resource.data.targetCenterId != null && resource.data.targetCenterId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        (resource.data.targetCenterId != null && resource.data.targetCenterId == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isSignedIn() && (
        incoming().doctorId == request.auth.uid || 
        isAdmin()
      );

      allow update: if isSignedIn() && (
        existing().doctorId == request.auth.uid || 
        (existing().targetCenterId != null && existing().targetCenterId == request.auth.uid) ||
        isAdmin()
      ) && incoming().doctorId == existing().doctorId;

      allow delete: if isAdmin();
    }

    // Notifications: /notifications/{notificationId}
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        existing().recipientUid == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        existing().recipientUid == request.auth.uid || 
        isAdmin()
      );
    }

    // Device Push Tokens (Subcollection): /users/{userId}/device_tokens/{tokenId}
    match /users/{userId}/device_tokens/{tokenId} {
      allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Global Device Push Tokens: /device_tokens/{tokenId}
    match /device_tokens/{tokenId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // Push Notification Outbox & Queue: /push_outbox/{jobId}
    match /push_outbox/{jobId} {
      allow get: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().recipientUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Patient Profiles & Medical Conditions: /patient_profiles/{patientId}
    // Strictly isolated: only patient owner, Super Admin, or a doctor with an active chart link can get;
    // list is forbidden for non-admins to prevent browsing unrelated patients or medical conditions.
    match /patient_profiles/{patientId} {
      allow get: if isSignedIn() && (
        isOwner(patientId) || 
        isAdmin() ||
        exists(/databases/$(database)/documents/doctor_patient_charts/$('chart_' + request.auth.uid + '_' + patientId))
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if (isOwner(patientId) || isAdmin()) 
        && incoming().patientId == patientId
        && (incoming().patientId == request.auth.uid || isAdmin());
      allow update: if (isOwner(patientId) || isAdmin())
        && incoming().patientId == existing().patientId;
      allow delete: if isAdmin() || isOwner(patientId);
    }

    // Subscriptions: /subscriptions/{subscriptionId}
    // CRITICAL SECURITY: Only verified Super Admin may create, activate, modify, or delete subscriptions.
    // Receipt upload or payment request submission NEVER activates or modifies a subscription.
    match /subscriptions/{subscriptionId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // Official Receiving Wallet Settings: /payment_settings/{settingId}
    match /payment_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Wallet Settings Modification History: /payment_settings_history/{entryId}
    match /payment_settings_history/{entryId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    // Manual Payment Request Validation Helper (Anti-Update-Gap & Tamper Guard)
    function isValidPaymentRequest(data) {
      return data.keys().hasAll([
          'id', 'requestNumber', 'userId', 'userEmail', 'customerName',
          'institutionName', 'institutionType', 'planId', 'planNameAr', 'planNameEn',
          'billingPeriod', 'expectedAmountIqd', 'amountIqd', 'paymentMethod',
          'paymentMethodName', 'receivingWalletNumber', 'transferDate',
          'receiptId', 'receiptUrl', 'receiptStoragePath', 'receiptFileName',
          'receiptMimeType', 'receiptSizeBytes', 'status', 'submittedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'requestNumber', 'userId', 'userEmail', 'customerName',
          'institutionName', 'institutionType', 'planId', 'planNameAr', 'planNameEn',
          'billingPeriod', 'expectedAmountIqd', 'amountIqd', 'paymentMethod',
          'paymentMethodName', 'receivingWalletNumber', 'transferDate',
          'transactionReference', 'customerNote',
          'receiptId', 'receiptUrl', 'receiptStoragePath', 'receiptFileName',
          'receiptMimeType', 'receiptSizeBytes', 'status', 'internalNote',
          'rejectionReason', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt',
          'approvedByUid', 'approvedAt', 'activatedSubscriptionStartDate',
          'activatedSubscriptionEndDate', 'submittedAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() <= 128
        && data.requestNumber is string && data.requestNumber.size() <= 64
        && data.userId is string && data.userId.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 128
        && data.customerName is string && data.customerName.size() <= 128
        && data.institutionName is string && data.institutionName.size() <= 160
        && data.institutionType is string && data.institutionType.size() <= 64
        && data.planId is string && data.planId.size() <= 128
        && data.billingPeriod in ['monthly', 'quarterly', 'yearly', 'custom']
        && data.expectedAmountIqd is number && data.expectedAmountIqd > 0
        && data.amountIqd is number && data.amountIqd > 0
        && data.paymentMethod in ['superqi', 'zaincash']
        && data.receivingWalletNumber is string && data.receivingWalletNumber.size() >= 7 && data.receivingWalletNumber.size() <= 32
        && data.transferDate is string && data.transferDate.size() <= 32
        && data.receiptId is string && data.receiptId.size() <= 128
        && data.receiptUrl is string && data.receiptUrl.size() <= 1024
        && data.receiptStoragePath is string && data.receiptStoragePath.size() <= 512
        && data.receiptSizeBytes is number && data.receiptSizeBytes > 0 && data.receiptSizeBytes <= 5242880
        && data.status in ['pending', 'under_review', 'approved', 'rejected']
        && data.submittedAt is string
        && data.updatedAt is string;
    }

    // Manual Wallet Transfer Payment Requests: /payment_requests/{requestId}
    match /payment_requests/{requestId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidPaymentRequest(incoming())
        && incoming().id == requestId
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().amountIqd == incoming().expectedAmountIqd;
      allow update: if isSignedIn()
        && isAdmin()
        && isValidId(requestId)
        && isValidPaymentRequest(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().planId == existing().planId
        && incoming().amountIqd == existing().amountIqd
        && incoming().expectedAmountIqd == existing().expectedAmountIqd
        && incoming().paymentMethod == existing().paymentMethod
        && incoming().receiptId == existing().receiptId
        && incoming().receiptUrl == existing().receiptUrl
        && incoming().submittedAt == existing().submittedAt
        && (
          (existing().status in ['pending', 'under_review'] && incoming().status in ['under_review', 'approved', 'rejected'])
          || (existing().status == incoming().status && incoming().diff(existing()).affectedKeys().hasOnly(['internalNote', 'updatedAt']))
        );
      allow delete: if false; // Preserve all payment requests for financial audit
    }

    // Payment Receipt Metadata: /payment_receipts/{receiptId}
    match /payment_receipts/{receiptId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(receiptId)
        && incoming().keys().hasAll(['id', 'paymentRequestId', 'userId', 'fileName', 'mimeType', 'sizeBytes', 'storagePath', 'downloadUrl', 'uploadedAt'])
        && incoming().keys().hasOnly(['id', 'paymentRequestId', 'userId', 'fileName', 'mimeType', 'sizeBytes', 'storagePath', 'downloadUrl', 'uploadedAt'])
        && incoming().id == receiptId
        && incoming().userId == request.auth.uid
        && incoming().sizeBytes is number
        && incoming().sizeBytes > 0
        && incoming().sizeBytes <= 5242880
        && incoming().mimeType is string
        && incoming().mimeType.matches('^(image/(jpeg|jpg|png|webp|heic|heif)|application/pdf)$');
      allow update, delete: if false; // Preserve uploaded receipts permanently
    }

    // Verified Financial Subscription Transactions: /subscription_transactions/{txId}
    match /subscription_transactions/{txId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin()
        && isValidId(txId)
        && incoming().id == txId
        && incoming().amountIqd is number
        && incoming().amountIqd > 0
        && incoming().paymentMethod in ['superqi', 'zaincash'];
      allow update, delete: if false; // Immutable verified financial ledger
    }

    // Legacy Payment Gateway Transactions (Read-only archive for Super Admin & owner)
    match /payment_transactions/{transactionId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // Subscription Plans: /subscription_plans/{planId}
    match /subscription_plans/{planId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Wholesaler Profiles: /wholesaler_profiles/{wholesalerId}
    match /wholesaler_profiles/{wholesalerId} {
      allow get, list: if isSignedIn();
      allow create: if (isOwner(wholesalerId) || isAdmin()) 
        && incoming().wholesalerId == wholesalerId
        && incoming().wholesalerId == request.auth.uid;
      allow update: if (isOwner(wholesalerId) || isAdmin())
        && incoming().wholesalerId == existing().wholesalerId;
      allow delete: if isAdmin() || isOwner(wholesalerId);
    }

    // Wholesale Medicines: /wholesale_medicines/{medicineId}
    match /wholesale_medicines/{medicineId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        incoming().wholesalerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().wholesalerId == request.auth.uid || isAdmin()
      ) && incoming().wholesalerId == existing().wholesalerId;
      allow delete: if isSignedIn() && (
        existing().wholesalerId == request.auth.uid || isAdmin()
      );
    }

    // Wholesale Orders: /wholesale_orders/{orderId}
    match /wholesale_orders/{orderId} {
      allow get: if isSignedIn() && (
        resource.data.wholesalerId == request.auth.uid || 
        resource.data.pharmacyId == request.auth.uid || 
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.wholesalerId == request.auth.uid || 
        resource.data.pharmacyId == request.auth.uid || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          incoming().pharmacyId == request.auth.uid
          && incoming().wholesalerId is string
          && incoming().wholesalerId != request.auth.uid
          && incoming().status == 'pending'
          && incoming().totalAmountIqd is number
          && incoming().totalAmountIqd > 0
          && incoming().items is list
          && incoming().items.size() > 0
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          existing().wholesalerId == request.auth.uid
          && incoming().wholesalerId == existing().wholesalerId
          && incoming().pharmacyId == existing().pharmacyId
          && incoming().status in ['approved', 'preparing', 'dispatched', 'delivered', 'rejected', 'cancelled']
        ) ||
        (
          existing().pharmacyId == request.auth.uid
          && incoming().wholesalerId == existing().wholesalerId
          && incoming().pharmacyId == existing().pharmacyId
          && existing().status == 'pending'
          && incoming().status == 'cancelled'
        )
      );

      allow delete: if isAdmin();
    }

    // System Audit Logs: /system_audit_logs/{logId}
    match /system_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    function isConversationParticipantDocData(convData) {
      return convData != null && (
        ('participantIds' in convData && convData.participantIds is list && request.auth.uid in convData.participantIds) ||
        ('participants' in convData && convData.participants is map && request.auth.uid in convData.participants) ||
        ('doctorId' in convData && convData.doctorId == request.auth.uid) ||
        ('patientId' in convData && convData.patientId == request.auth.uid)
      );
    }

    function isConversationParticipantData(convData) {
      return isAdmin() || isConversationParticipantDocData(convData);
    }

    function isParentConversationParticipant(convId) {
      return exists(/databases/$(database)/documents/conversations/$(convId)) &&
        isConversationParticipantDocData(get(/databases/$(database)/documents/conversations/$(convId)).data);
    }

    // Unified Private Conversations Across Authorized Portal Pairs: /conversations/{convId}
    match /conversations/{convId} {
      allow get: if isSignedIn() && (
        isSuperAdminEmail() ||
        isAdmin() ||
        resource == null ||
        isConversationParticipantData(resource.data)
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds ||
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        isSuperAdminEmail()
      );
      allow create: if isSignedIn() && isValidId(convId) && (
        isAdmin() ||
        (
          'participantIds' in incoming()
          && incoming().participantIds is list
          && incoming().participantIds.size() == 2
          && request.auth.uid in incoming().participantIds
          && incoming().participantIds[0] != incoming().participantIds[1]
        ) ||
        (
          ('doctorId' in incoming() && incoming().doctorId == request.auth.uid) ||
          ('patientId' in incoming() && incoming().patientId == request.auth.uid)
        )
      );
      allow update: if isSignedIn() && isValidId(convId) && (
        isAdmin() ||
        (
          isConversationParticipantData(existing())
          && (
            (
              (
                !('participantIds' in existing())
                || existing().participantIds == null
                || (existing().participantIds is list && existing().participantIds.size() < 2)
              )
              && (
                !('participantIds' in incoming())
                || (
                  incoming().participantIds is list
                  && incoming().participantIds.size() == 2
                  && request.auth.uid in incoming().participantIds
                  && incoming().participantIds[0] != incoming().participantIds[1]
                )
              )
            )
            || (
              existing().participantIds is list
              && existing().participantIds.size() >= 2
              && incoming().participantIds is list
              && incoming().participantIds.size() == 2
              && request.auth.uid in incoming().participantIds
              && incoming().participantIds[0] != incoming().participantIds[1]
              && incoming().participantIds.hasAll(existing().participantIds)
              && existing().participantIds.hasAll(incoming().participantIds)
            )
          )
        )
      );
      allow delete: if isAdmin();

      // Messages Subcollection: /conversations/{convId}/messages/{msgId}
      match /messages/{msgId} {
        allow get: if isSignedIn() && (
          isSuperAdminEmail() ||
          isAdmin() ||
          isParentConversationParticipant(convId)
        );
        allow list: if isSignedIn() && (
          isSuperAdminEmail() ||
          isParentConversationParticipant(convId)
        );
        allow create: if isSignedIn()
          && isValidId(msgId)
          && incoming().senderId == request.auth.uid
          && incoming().conversationId == convId
          && incoming().text is string
          && incoming().text.size() > 0
          && incoming().text.size() <= 10000
          && incoming().timestamp is string
          && (
            isAdmin() ||
            isParentConversationParticipant(convId)
          );
        allow update: if isSignedIn() && isValidId(msgId) && (
          isAdmin() ||
          (
            isParentConversationParticipant(convId)
            && incoming().senderId == existing().senderId
            && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          )
        );
        allow delete: if isAdmin();
      }
    }

    // Patient-Controlled Medical Record Sharing Permissions: /record_sharing_permissions/{permId}
    match /record_sharing_permissions/{permId} {
      allow get, list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.targetDoctorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().patientId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().patientId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        existing().patientId == request.auth.uid ||
        isAdmin()
      );
    }

    // Platform Legal Settings & Contract Templates: /system_settings/{settingId}
    match /system_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Platform Realtime Public Metrics (Zero-PII aggregated live counters)
    match /platform_metrics/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Health-check connectivity probe conforming to Firebase Integration Skill
    match /test/{docId} {
      allow read: if true;
    }
  }
}

